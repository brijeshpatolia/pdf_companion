# Copy to .env.local and fill in. For local dev, run `npx supabase status`
# to get the URL and keys for your local stack.

# --- Server-side (never exposed to the browser) ---
# Service role bypasses RLS; used only by the background ingestion job.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Public (inlined into the browser bundle) ---
# Anon key is safe to expose; RLS enforces per-user access.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Ingestion tuning (optional) ---
# Ingestion embeds pages in batches and hands off to a fresh run when its time
# budget is spent. Defaults (25 pages, 40s) suit a 60s serverless function;
# raise the budget if your platform allows longer runs.
# INGEST_BATCH_SIZE=25
# INGEST_TIME_BUDGET_MS=40000

# --- AI gateway (one of these) ---
# ANTHROPIC_API_KEY takes precedence if both are set.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
